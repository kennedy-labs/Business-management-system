generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The business's M-Pesa balance, read twice per period.
///
/// This is the v1 source of truth for M-Pesa money: the worker reads the
/// account balance when they start (e.g. 6,005 at 08:43) and again when they
/// finish (e.g. 16,005 at 09:31). The money taken during the period is simply
/// `closingBalance - openingBalance`. No accounts registry, no SMS parsing,
/// no per-transaction attribution — one row per period is the whole model.
model MpesaPeriodBalance {
  id             String    @id @default(cuid())
  businessId     String
  branchId       String
  shiftId        String    @unique
  openingBalance Decimal
  openingAt      DateTime
  closingBalance Decimal?
  closingAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id])
  branch         Branch    @relation(fields: [branchId], references: [id])
  shift          Shift     @relation(fields: [shiftId], references: [id])

  @@index([businessId, openingAt])
}

/// The owner's confirmation that a worker accounted for the period correctly:
/// "I gave you stock, you sold it, you returned the remaining stock plus the
/// money." Every figure is snapshotted at decision time because product prices
/// and costs change later, and the historical confirmation must not move.
model ShiftReconciliation {
  id              String               @id @default(cuid())
  businessId      String
  branchId        String
  shiftId         String               @unique
  expectedRevenue Decimal              @default(0)
  expectedCost    Decimal              @default(0)
  expectedProfit  Decimal              @default(0)
  declaredCash    Decimal              @default(0)
  declaredMpesa   Decimal              @default(0)
  declaredCredit  Decimal              @default(0)
  declaredTotal   Decimal              @default(0)
  variance        Decimal              @default(0)
  status          ReconciliationStatus @default(AWAITING_OWNER)
  confirmedById   String?
  confirmedAt     DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  business        Business             @relation(fields: [businessId], references: [id])
  branch          Branch               @relation(fields: [branchId], references: [id])
  shift           Shift                @relation(fields: [shiftId], references: [id])

  @@index([businessId, status])
  @@index([branchId, createdAt])
}

model Business {
  id                String             @id @default(cuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  currency          String             @default("KES")
  email             String?
  phone             String?
  timezone          String             @default("Africa/Nairobi")
  /// SHIFT businesses run time-boxed shifts; DAILY businesses have a single
  /// open/close cycle per day. Both share the same accountability period model.
  periodMode        PeriodMode         @default(SHIFT)
  branches          Branch[]
  discrepancies     Discrepancy[]
  products          Product[]
  stockMovements    StockMovement[]    @relation("BusinessStockMovements")
  stockLocations    StockLocation[]
  transfers         Transfer[]
  userBusinesses    UserBusiness[]
  periodBalances    MpesaPeriodBalance[]
  reconciliations   ShiftReconciliation[]
}

model Branch {
  id                String          @id @default(cuid())
  name              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id])
  discrepancies     Discrepancy[]
  expenses          Expense[]
  inventory         InventoryItem[]
  shifts            Shift[]
  movements         StockMovement[]
  receiverTransfers Transfer[]      @relation("ReceiverTransfers")
  senderTransfers   Transfer[]      @relation("SenderTransfers")
  users             User[]
  periodBalances    MpesaPeriodBalance[]
  reconciliations   ShiftReconciliation[]

  @@unique([businessId, name])
}

model Product {
  id              String               @id @default(cuid())
  name            String
  sellingPrice    Float
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  businessId      String
  inventory       InventoryItem[]
  business        Business             @relation(fields: [businessId], references: [id])
  costHistory     ProductCostHistory[]
  units           ProductUnit[]
  shiftStockItems ShiftStockItem[]
  movements       StockMovement[]
  transferItems   TransferItem[]
  discrepancies   Discrepancy[]
  // A product exists in exactly one place.
  stockLocationId String?
  stockLocation   StockLocation?       @relation(fields: [stockLocationId], references: [id])

  @@unique([businessId, name])
}

model ProductCostHistory {
  id          String   @id @default(cuid())
  productId   String
  costPrice   Float
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
}

model Expense {
  id                  String        @id @default(cuid())
  amount              Float
  description         String?
  branchId            String
  createdById         String?
  status              ExpenseStatus @default(RECORDED)
  acknowledgedByUserId String?
  acknowledgedAt      DateTime?
  createdAt           DateTime      @default(now())
  discrepancies       Discrepancy[]
  branch              Branch        @relation(fields: [branchId], references: [id])
  createdBy           User?         @relation("UserExpenses", fields: [createdById], references: [id])
  acknowledgedBy       User?         @relation("UserAcknowledgedExpenses", fields: [acknowledgedByUserId], references: [id])
}

model ProductUnit {
  id             String          @id @default(cuid())
  productId      String
  name           String
  symbol         String
  quantity       Decimal
  conversionFactor Decimal?
  isDefault      Boolean         @default(false)
  status         ProductUnitStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]
  transferItems  TransferItem[]
  inventoryItems InventoryItem[]
  shiftStockItems ShiftStockItem[]
}

model User {
  id                String          @id @default(cuid())
  name              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  role              UserRole        @default(WORKER)
  status            UserStatus      @default(ACTIVE)
  phone             String?
  email             String?
  password          String          @default("temporary_password")
  branchId          String?
  discrepancies     Discrepancy[]   @relation("UserDiscrepancies")
  expensesCreated   Expense[]       @relation("UserExpenses")
  expensesAcknowledged Expense[]    @relation("UserAcknowledgedExpenses")
  shifts            Shift[]
  stockMovements    StockMovement[]
  receiverTransfers Transfer[]      @relation("ReceiverTransfers")
  senderTransfers   Transfer[]      @relation("SenderTransfers")
  userBusinesses    UserBusiness[]
  branch            Branch?         @relation(fields: [branchId], references: [id])
}

model UserBusiness {
  id         String      @id @default(cuid())
  userId     String
  businessId String
  role       UserRole    @default(WORKER)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id])
  business   Business    @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
}

model InventoryItem {
  id              String         @id @default(cuid())
  quantity        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  branchId        String
  productId       String
  productUnitId   String
  stockLocationId String?
  branch          Branch         @relation(fields: [branchId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  productUnit     ProductUnit    @relation(fields: [productUnitId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])

  @@unique([branchId, productId, productUnitId])
}

model StockMovement {
  id              String         @id @default(cuid())
  quantity        Int
  type            MovementType
  createdAt       DateTime       @default(now())
  branchId        String
  productId       String
  shiftId         String?
  stockLocationId String?
  transferId      String?
  businessId      String
  productUnitId   String
  userId          String?
  discrepancies   Discrepancy[]
  branch          Branch         @relation(fields: [branchId], references: [id])
  business        Business       @relation("BusinessStockMovements", fields: [businessId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  productUnit     ProductUnit    @relation(fields: [productUnitId], references: [id])
  shift           Shift?         @relation(fields: [shiftId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])
  transfer        Transfer?      @relation(fields: [transferId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
}

model StockLocation {
  id        String            @id @default(cuid())
  businessId String
  name      String
  type      StockLocationType
  description String?
  status    StockLocationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  business          Business          @relation(fields: [businessId], references: [id])
  inventory         InventoryItem[]
  movements         StockMovement[]
  shiftStockItems   ShiftStockItem[]
  receivedTransfers Transfer[]        @relation("ReceiverLocationTransfers")
  products          Product[]
  sentTransfers     Transfer[]        @relation("SenderLocationTransfers")
  discrepancies     Discrepancy[]
}

model ShiftStockItem {
  id              String   @id @default(cuid())
  shiftId         String
  productId       String
  businessId      String
  branchId        String
  productUnitId   String
  stockLocationId String?
  openingQuantity Int
  addedQuantity   Int      @default(0)
  closingQuantity Int?
  soldQuantity    Int?
  revenue         Decimal?
  cost            Decimal?
  grossProfit     Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id])
  shift           Shift    @relation(fields: [shiftId], references: [id])
  productUnit     ProductUnit @relation(fields: [productUnitId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])
}

model Transfer {
  id               String          @id @default(cuid())
  createdAt        DateTime        @default(now())
  status           TransferStatus  @default(PENDING)
  notes            String?
  receivedAt       DateTime?
  businessId       String
  dispatchedAt     DateTime?
  receiverBranchId String
  receiverLocationId String?
  receiverUserId   String?
  senderBranchId   String
  senderLocationId String?
  senderUserId     String
  updatedAt        DateTime        @updatedAt
  discrepancies    Discrepancy[]
  stockMovements   StockMovement[]
  business         Business        @relation(fields: [businessId], references: [id])
  receiverBranch   Branch          @relation("ReceiverTransfers", fields: [receiverBranchId], references: [id])
  receiverLocation StockLocation?  @relation("ReceiverLocationTransfers", fields: [receiverLocationId], references: [id])
  receiverUser     User?           @relation("ReceiverTransfers", fields: [receiverUserId], references: [id])
  senderBranch     Branch          @relation("SenderTransfers", fields: [senderBranchId], references: [id])
  senderLocation   StockLocation?  @relation("SenderLocationTransfers", fields: [senderLocationId], references: [id])
  senderUser       User            @relation("SenderTransfers", fields: [senderUserId], references: [id])
  items            TransferItem[]
}

model TransferItem {
  id            String      @id @default(cuid())
  transferId    String
  productId     String
  productUnitId String
  quantity      Int
  createdAt     DateTime    @default(now())
  product       Product     @relation(fields: [productId], references: [id])
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])
  transfer      Transfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model Discrepancy {
  id              String            @id @default(cuid())
  description     String?
  branchId        String
  shiftId         String?
  transferId      String?
  stockMovementId String?
  expenseId       String?
  productId       String?
  locationId       String?
  createdById     String?
  createdAt       DateTime          @default(now())
  actualValue     Decimal
  businessId      String
  expectedValue   Decimal
  expectedQuantity Int?
  actualQuantity   Int?
  quantityDifference Int?
  resolution      String?
  sourceReference String            @unique
  status          DiscrepancyStatus @default(OPEN)
  updatedAt       DateTime          @updatedAt
  variance        Decimal
  type            DiscrepancyType
  branch          Branch            @relation(fields: [branchId], references: [id])
  business        Business          @relation(fields: [businessId], references: [id])
  user            User?             @relation("UserDiscrepancies", fields: [createdById], references: [id])
  expense         Expense?          @relation(fields: [expenseId], references: [id])
  shift           Shift?            @relation(fields: [shiftId], references: [id])
  stockMovement   StockMovement?    @relation(fields: [stockMovementId], references: [id])
  transfer        Transfer?         @relation(fields: [transferId], references: [id])
  product         Product?          @relation(fields: [productId], references: [id])
  location         StockLocation?    @relation(fields: [locationId], references: [id])

  @@index([businessId, status])
  @@index([branchId, createdAt])
  @@index([shiftId])
}

model Shift {
  id                String             @id @default(cuid())
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  branchId          String
  userId            String
  /// SHIFT = a time-boxed shift, DAILY = the whole trading day for businesses
  /// that have a single worker opening and closing. Same accountability flow.
  periodType        PeriodType         @default(SHIFT)
  discrepancies     Discrepancy[]
  branch            Branch             @relation(fields: [branchId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  shiftStockItems   ShiftStockItem[]
  movements         StockMovement[]
  mpesaBalances     MpesaPeriodBalance[]
  reconciliation    ShiftReconciliation?
}

enum MovementType {
  SUPPLIER_DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  ADJUSTMENT
  SHIFT_ADDITION
}

enum UserRole {
  OWNER
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StockLocationType {
  COUNTER
  STORAGE
}

enum StockLocationStatus {
  ACTIVE
  INACTIVE
}

enum TransferStatus {
  PENDING
  SENDER_CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}


/// Whether operational periods are time-boxed shifts or whole trading days.
enum PeriodType {
  SHIFT
  DAILY
}

/// The business-wide default for the above.
enum PeriodMode {
  SHIFT
  DAILY
}

/// Where a period sits in the owner-confirms-the-worker loop.
enum ReconciliationStatus {
  AWAITING_WORKER
  AWAITING_OWNER
  CONFIRMED
  DISPUTED
}

enum DiscrepancyType {
  STOCK_SHORTAGE
  CASH_SHORTAGE
  MPESA_MISMATCH
  TRANSFER_MISMATCH
  UNCONFIRMED_ADDITION
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
}

enum ProductUnitStatus {
  ACTIVE
  INACTIVE
}

enum ExpenseStatus {
  RECORDED
  ACKNOWLEDGED
}
